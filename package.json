{
  "version": "0.0.23",
  "dependencies": {
    "@calcit/procs": "0.19.1"
  },
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "build": "yarn compile-page && vite build",
    "compile-page": "calcit calcit.cirru js",
    "compile-server": "calcit calcit.cirru --entry server js",
    "dev": "vite",
    "test": "yarn compile-page && node tests/browser-lifecycle.mjs && bash scripts/check-realtime-primitives.sh",
    "watch-page": "calcit calcit.cirru js -w",
    "watch-server": "calcit calcit.cirru --entry server js -w"
  },
  "devDependencies": {
    "vite": "^8.0.5"
  }
}
